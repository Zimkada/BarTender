# =====================================================
# EDGE FUNCTION ENVIRONMENT VARIABLES (EXAMPLE)
# =====================================================
# Copier ce fichier et configurer les secrets via:
# supabase secrets set KEY=value
# =====================================================

# Resend API Configuration
# Obtenir sur: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email Configuration
ADMIN_EMAIL=admin@bartender.app
SMTP_FROM=noreply@bartender.app

# Security
# Générer avec: openssl rand -base64 32
FUNCTION_SECRET=your-random-secure-token-here

# Alert Thresholds
ALERT_THRESHOLD=3

# FedaPay (paiements d'abonnement Mobile Money)
# Clés distinctes sandbox/production — obtenir sur https://live.fedapay.com (ou sandbox.fedapay.com)
# Sandbox: https://sandbox-api.fedapay.com | Production: https://api.fedapay.com
FEDAPAY_API_BASE=https://sandbox-api.fedapay.com
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxx
# Secret du webhook (dashboard FedaPay > Webhooks) — pour la vérification HMAC
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxx
# URL de l'app (callback de retour après paiement)
APP_BASE_URL=https://bar-tender-ten.vercel.app

# =====================================================
# Agent WhatsApp (wa-webhook)
# =====================================================
# Meta / WhatsApp Business Cloud API — obtenir sur developers.facebook.com
# (app Meta Business > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token de vérification du webhook — chaîne choisie par vous, la même que dans
# la config du webhook Meta. Générer avec: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
# App Secret Meta (app > Settings > Basic) — vérification de signature HMAC
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Version de l'API Graph (optionnel, défaut v20.0)
# WHATSAPP_API_VERSION=v20.0

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# Modèle (optionnel, défaut claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Notification d'escalade best-effort vers votre WhatsApp (optionnel, format wa_id
# sans + : ex 2290155282525). Ne fonctionne que si une fenêtre de 24h est ouverte
# entre votre numéro et le numéro business.
# ADMIN_WHATSAPP_NUMBER=2290155282525

# Supabase (auto-injectés par Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
